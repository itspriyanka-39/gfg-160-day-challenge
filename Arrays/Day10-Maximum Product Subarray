class Solution {
    int maxProduct(int[] arr) {
        // code here
        int maxProd=arr[0];
        int minProd=arr[0];
        int ans=arr[0];
        for(int i=1; i<arr.length; i++){
            int temp=maxProd;
            
            maxProd=Math.max(arr[i],
            Math.max(maxProd * arr[i],
            minProd * arr[i]));
            
            minProd=Math.min(arr[i],
            Math.min(temp*arr[i],minProd*arr[i]));
            
            ans=Math.max(ans,maxProd);
        }
        return ans;
        
    }
}
