class Solution {
    public ArrayList<Integer> findMajority(int[] arr) {
        int n=arr.length;
        HashMap<Integer, Integer> map=new HashMap<>();
        for(int num:arr){
            map.put(num, map.getOrDefault(num,0)+1);
        }
        ArrayList<Integer> ans=new ArrayList<>();
        for(int key: map.keySet()){
            if (map.get(key)>n/3){
                
                ans.add(key);
            }
        }
        
        Collections.sort(ans);
        return ans;
    }
}
